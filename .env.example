# Environment variables used by this project.
# Copy to `.env.local` for local development (`.env.local` is git-ignored).
# For production, add the same variables in the Vercel project settings
# (Project -> Settings -> Environment Variables). Values are intentionally blank here.

# --- Contact form (app/api/contact/route.ts, contact-form.tsx, shopify-project-form.tsx) ---
# Web3Forms access key — https://web3forms.com
# NEXT_PUBLIC_* is read in the browser (client-side submit); the non-prefixed
# variable is read only on the server via /api/contact. Either one is enough.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
WEB3FORMS_ACCESS_KEY=

# --- Optional fallback: Resend — https://resend.com (used only if no Web3Forms key is set) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
